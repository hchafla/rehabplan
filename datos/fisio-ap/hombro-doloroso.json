{
  "id": "hombro-doloroso",
  "nombre": "Hombro doloroso - Tendinopatías de hombro",
  "fuente": "Protocolo de actuación SCS · Hombro doloroso / Tendinopatías de hombro (Atención Primaria)",

  "objetivos": {
    "fuente": "protocolo",
    "general": [
      "Devolver al hombro su funcionalidad, readaptando al paciente lo antes posible a la vida activa."
    ],
    "especificos": [
      "Disminuir el dolor.",
      "Reducir la inflamación.",
      "Mejorar/normalizar la movilidad, mejorando el balance articular.",
      "Recuperar el tono, la fuerza y la potencia muscular: reequilibración muscular.",
      "Corregir las posturas antiálgicas.",
      "Reeducar el ritmo escápulo-humeral.",
      "Prevenir la discapacidad, conservando la independencia del usuario.",
      "Fomentar la responsabilidad del usuario en el autocuidado.",
      "Prevenir complicaciones y recidivas."
    ]
  },

  "avisos": {
    "fuente": "protocolo",
    "criteriosInclusion": [
      "Persistencia de clínica dolorosa tras haber realizado tratamiento previo durante 4-6 semanas."
    ],
    "criteriosExclusion": [
      "Hombro doloroso postraumático.",
      "Hombro doloroso de etiología extrínseca.",
      "Capsulitis adhesiva (derivación a Rehabilitación)."
    ],
    "sesionesMaximas": 10
  },

  "motivo": {
    "fuente": "editable",
    "variables": [
      { "id": "centro_salud", "etiqueta": "Centro de Salud", "placeholder": "Ej. Canalejas" },
      { "id": "diagnostico_map", "etiqueta": "Diagnóstico MAP", "placeholder": "Ej. Tendinopatía supraespinoso" },
      { "id": "motivo_valoracion", "etiqueta": "Motivo valoración", "placeholder": "Ej. Hombro doloroso derecho" }
    ],
    "plantillas": [
      {
        "id": "motivo_cs",
        "etiqueta": "Acceso como fisioterapeuta del C.S.",
        "plantilla": "Acceso a HC del paciente como fisioterapeuta del C.S. {centro_salud}."
      },
      {
        "id": "motivo_map",
        "etiqueta": "Tras derivación de MAP por [Diagnóstico]",
        "plantilla": "Acceso a HC tras derivación de MAP por diagnóstico de {diagnostico_map}."
      },
      {
        "id": "motivo_val",
        "etiqueta": "Valoración fisioterapéutica por [Motivo]",
        "plantilla": "Acceso a HC tras derivación de MAP para valoración fisioterapéutica de {motivo_valoracion}."
      }
    ]
  },

